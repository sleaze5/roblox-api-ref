		{
			"element": "Member",
			"class": "AssetService",
			"member": "CreateAssetAsync",
			"part": "parameter",
			"parameter": "requestParameters",
			"before": "Options table containing asset metadata: - <code>Name</code> – Name of the asset as a string. Defaults to <code>[object.Name]</code>. - <code>Description</code> – Description of the asset as a string. Defaults to <code>\"Created with AssetService:CreateAssetAsync\"</code>. - <code>CreatorId</code> – ID of the asset creator as a number. Defaults to the logged in Roblox Studio user for Plugin context. Required for Open Cloud Luau Execution context. - <code>CreatorType</code> – <code>AssetCreatorType</code> indicating the type of asset creator. Defaults to <code>AssetCreatorType.User</code> in Plugin context. Required for Open Cloud Luau Execution context. - <code>IsPackage</code> – Boolean value, only applicable to the <code>AssetType.Model</code> type. Defaults to <code>true</code>.",
			"after": "Options table containing asset metadata: <ul> <li><code>Name</code> – Name of the asset as a string. Defaults to <code>[object.Name]</code>.</li> <li><code>Description</code> – Description of the asset as a string. Defaults to   <code>\"Created with AssetService:CreateAssetAsync\"</code>.</li> <li><code>CreatorId</code> – ID of the asset creator as a number. Defaults to the   logged in Roblox Studio user for Plugin context. Required for Open   Cloud Luau Execution context.</li> <li><code>CreatorType</code> – <code>AssetCreatorType</code> indicating the type of asset   creator. Defaults to <code>AssetCreatorType.User</code> in Plugin context.   Required for Open Cloud Luau Execution context.</li> <li><code>IsPackage</code> – Boolean value, only applicable to the   <code>AssetType.Model</code> type. Defaults to <code>true</code>.</li> </ul>",
