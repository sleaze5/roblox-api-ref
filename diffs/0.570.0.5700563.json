		{
			"element": "EnumItem",
			"enum": "SafeAreaCompatibility",
			"item": "None",
			"part": "description",
			"before": null,
			"after": "Do not apply compatibility transformations to any descendants of the <code>ScreenGui</code>.",
			"value": {
				"Name": "None",
				"Value": 0
			}
		},
		{
			"element": "EnumItem",
			"enum": "SafeAreaCompatibility",
			"item": "FullscreenExtension",
			"part": "description",
			"before": null,
			"after": "If the total area of any descendant <code>GuiObject</code> within the <code>ScreenGui</code> (including any applied border or <code>UIStroke</code>) covers the device's safe area both horizontally and vertically, its background area will be expanded to cover the fullscreen area. This expansion does <strong>not</strong> affect the size or position of the descendant's <strong>content</strong>, except in the case of <code>ImageLabel</code>, <code>ImageButton</code>, or <code>VideoFrame</code> where the image/video is considered part of the background and will be expanded to fullscreen. Note that this option is intended to automatically improve the appearance of UI that was authored for screens without any cutouts. However, it's recommended that you avoid fullscreen extensions for new work; instead, use the <code>ScreenInsets</code> property to specify which insets should be respected for different <code>ScreenGuis</code>.",
			"value": {
				"Name": "FullscreenExtension",
				"Value": 1
			}
		},
		{
			"element": "EnumItem",
			"enum": "ScreenInsets",
			"item": "None",
			"part": "description",
			"before": null,
			"after": "No insets are added to the fullscreen area. This mode may result in UI that is obscured or completely hidden by device notches and cutouts, so you should only use it for a <code>ScreenGui</code> that contains noninteractive content like background images.",
			"value": {
				"Name": "None",
				"Value": 0
			}
		},
		{
			"element": "EnumItem",
			"enum": "ScreenInsets",
			"item": "DeviceSafeInsets",
			"part": "description",
			"before": null,
			"after": "Device safe area insets are added to the fullscreen area. The resulting area is guaranteed to not be occluded by any <strong>device</strong> screen cutouts such as the camera notch, although no inset is added for Roblox core UI elements like the top bar buttons. As such, it's recommended that you use <strong>CoreUISafeInsets</strong> for a <code>ScreenGui</code> whose contents should remain unobscured by both device cutouts <strong>and</strong> core screen elements.",
			"value": {
				"Name": "DeviceSafeInsets",
				"Value": 1
			}
		},
		{
			"element": "EnumItem",
			"enum": "ScreenInsets",
			"item": "CoreUISafeInsets",
			"part": "description",
			"before": null,
			"after": "Core UI insets are added to the <strong>DeviceSafeInsets</strong> area, resulting in an area guaranteed to be unobscured by both device screen cutouts and Roblox core UI elements like the top bar buttons. This mode is recommended for any <code>ScreenGui</code> that contains interactive and/or important UI elements such as buttons and status messages.",
			"value": {
				"Name": "CoreUISafeInsets",
				"Value": 2
			}
		}
	]
