	"descriptions": [
		{
			"element": "Member",
			"class": "Terrain",
			"member": "ReadVoxelChannels",
			"part": "description",
			"before": null,
			"after": "Returns a region of terrain voxel data in table format based on the channel names.",
			"value": {
