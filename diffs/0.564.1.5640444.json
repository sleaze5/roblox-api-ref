		{
			"element": "Member",
			"class": "Model",
			"member": "ModelStreamingMode",
			"part": "description",
			"before": null,
			"after": "Controls the model streaming behavior on <code>Model</code> instances when streaming is enabled.",
			"value": {
				"Category": "Behavior",
				"Default": "Default",
				"MemberType": "Property",
				"Name": "ModelStreamingMode",
				"Security": {
					"Read": "None",
					"Write": "None"
				},
				"Serialization": {
					"CanLoad": true,
					"CanSave": true
				},
				"ThreadSafety": "ReadSafe",
				"ValueType": {
					"Category": "Enum",
					"Name": "ModelStreamingMode"
				}
			}
		},
		{
			"element": "Member",
			"class": "Model",
			"member": "AddPersistentPlayer",
			"part": "description",
			"before": null,
			"after": "Sets this model to be persistent for the specified player. <code>Model.ModelStreamingMode</code> must be set to <strong>PersistentPerPlayer</strong> for behavior to be changed as a result of addition.",
			"value": {
				"MemberType": "Function",
				"Name": "AddPersistentPlayer",
				"Parameters": [
					{
						"Default": "nil",
						"Name": "playerInstance",
						"Type": {
							"Category": "Class",
							"Name": "Player"
						}
					}
				],
				"ReturnType": {
					"Category": "Primitive",
					"Name": "void"
				},
				"Security": "None",
				"ThreadSafety": "Unsafe"
			}
		},
		{
			"element": "Member",
			"class": "Model",
			"member": "RemovePersistentPlayer",
			"part": "description",
			"before": null,
			"after": "Makes this model no longer persistent for specified player. <code>Model.ModelStreamingMode</code> must be set to <strong>PersistentPerPlayer</strong> for behavior to be changed as a result of removal.",
			"value": {
				"MemberType": "Function",
				"Name": "RemovePersistentPlayer",
				"Parameters": [
					{
						"Default": "nil",
						"Name": "playerInstance",
						"Type": {
							"Category": "Class",
							"Name": "Player"
						}
					}
				],
				"ReturnType": {
					"Category": "Primitive",
					"Name": "void"
				},
				"Security": "None",
				"ThreadSafety": "Unsafe"
			}
		},
		{
			"element": "Member",
			"class": "Workspace",
			"member": "PersistentLoaded",
			"part": "description",
			"before": null,
			"after": "Fires when persistent models have been sent to the specified player.",
			"value": {
				"MemberType": "Event",
				"Name": "PersistentLoaded",
				"Parameters": [
					{
						"Name": "player",
						"Type": {
							"Category": "Class",
							"Name": "Player"
						}
					}
				],
				"Security": "None",
				"ThreadSafety": "Unsafe"
			}
		},
		{
			"element": "Member",
			"class": "Player",
			"member": "CharacterAppearanceLoaded",
			"part": "description",
			"before": "Fires when the full appearance of a <code>Player</code>'s <code>Player.Character</code> has been inserted.",
			"after": "Fires when the full appearance of a <code>Player.Character</code> has been inserted.",
			"value": {
				"MemberType": "Event",
				"Name": "CharacterAppearanceLoaded",
				"Parameters": [
					{
						"Name": "character",
						"Type": {
							"Category": "Class",
							"Name": "Model"
						}
					}
				],
				"Security": "None",
				"ThreadSafety": "Unsafe"
			}
		},
		{
			"element": "Class",
			"class": "VoiceChatService",
			"part": "description",
			"before": null,
			"after": "<strong>VoiceChatService</strong> holds voice functions not tied to other instances."
		},
		{
			"element": "EnumItem",
			"enum": "ModelLevelOfDetail",
			"item": "Automatic",
			"part": "description",
			"before": null,
			"after": "Default behavior, currently equivalent to <strong>Disabled</strong>.",
			"value": {
				"Name": "Automatic",
				"Value": 0
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelLevelOfDetail",
			"item": "StreamingMesh",
			"part": "description",
			"before": null,
			"after": "A low resolution mesh will be displayed when any descendant of a <code>Model</code> with this setting is not streamed in.",
			"value": {
				"Name": "StreamingMesh",
				"Value": 1
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelLevelOfDetail",
			"item": "Disabled",
			"part": "description",
			"before": null,
			"after": "No low level-of-detail mesh will be displayed.",
			"value": {
				"Name": "Disabled",
				"Value": 2
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelStreamingMode",
			"item": "Default",
			"part": "description",
			"before": null,
			"after": "Engine determines best behavior. Currently equivalent to <strong>Nonatomic</strong>.",
			"value": {
				"Name": "Default",
				"Value": 0
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelStreamingMode",
			"item": "Atomic",
			"part": "description",
			"before": null,
			"after": "The <code>Model</code> and all of its descendants are streamed in/out together. For streaming in, this applies when <strong>any</strong> descendant <code>BasePart</code> is eligible for streaming in. For streaming out, this applies when <strong>all</strong> descendant <code>BaseParts</code> are eligible for streaming out.",
			"value": {
				"Name": "Atomic",
				"Value": 1
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelStreamingMode",
			"item": "Persistent",
			"part": "description",
			"before": null,
			"after": "Persistent models are sent as a complete atomic unit soon after the player joins and before the <code>Workspace.PersistentLoaded</code> event fires. Persistent models and their descendants are never streamed out.",
			"value": {
				"Name": "Persistent",
				"Value": 2
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelStreamingMode",
			"item": "PersistentPerPlayer",
			"part": "description",
			"before": null,
			"after": "Behaves as a persistent model for players that have been added using <code>Model:AddPersistentPlayer()</code>. For other players, behavior is the same as <strong>Atomic</strong>. You can revert a model from player persistence via <code>Model:RemovePersistentPlayer()</code>.",
			"value": {
				"Name": "PersistentPerPlayer",
				"Value": 3
			}
		},
		{
			"element": "EnumItem",
			"enum": "ModelStreamingMode",
			"item": "Nonatomic",
			"part": "description",
			"before": null,
			"after": "When a nonatomic model is streamed, descendants are also sent, except for part descendants. Nonatomic models that are not descendants of parts are sent during experience loading.",
			"value": {
				"Name": "Nonatomic",
				"Value": 4
			}
		}
	]
}
